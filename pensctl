#!/usr/bin/env bash
# pensctl — manage the fully-local pens/ organization (AUTO-GENERATED pointer repo).
# The pens repo tracks ONLY manager + registry files; every pen dir is ignored via
# `*` so pens is a pointer superproject (like .meta.yaml), never a monorepo.
#
#   pensctl list                    list pens + git/local status
#   pensctl add <pen>               create a new pen (dir) + regenerate ignore
#   pensctl generate-ignore         regenerate .gitignore (* ignores every pen)
#   pensctl generate-yaml           regenerate pens.yaml from the live pen dirs + olympus registry
#   pensctl generate-pantheon       regenerate olympus-pantheon.md from local olympus/README.md
#   pensctl doctor                  health: pens root git-less per-dir, no stray tracked content
set -u
PENS_ROOT="${PENS_ROOT:-/home/toxic/pens}"
PENS_CTL="$PENS_ROOT/pensctl"

pens() { (cd "$PENS_ROOT" && ls -d */ 2>/dev/null | sed 's#/$##'); }

# --- generate .gitignore: `*` ignores every pen; only manager+registry tracked ---
generate_ignore() {
  {
    echo "# pens/.gitignore — AUTO-GENERATED by pensctl (do not edit by hand)."
    echo "# Pens repo is a POINTER superproject: '*' ignores every pen dir so it is never a monorepo."
    echo "# No submodules. Regenerate: pensctl generate-ignore"
    echo "*"
    echo "!.gitignore"
    echo "!pensctl"
    echo "!pens.yaml"
    echo "!olympus-pantheon.md"
    echo "!README.md"
  } > "$PENS_ROOT/.gitignore"
  echo "regenerated $PENS_ROOT/.gitignore"
}

# --- generate pens.yaml from live pen dirs (auto) ---
generate_yaml() {
  local pm="# pens.yaml — AUTO-GENERATED by pensctl (do not edit by hand). Regenerate: pensctl generate-yaml"
  pm="$pm\n# pens is a pointer/pointer superproject: tracks this manifest only; every pen dir is git-ignored."
  pm="$pm\n\npens:"
  for p in $(pens); do
    local kind="local-dir"; [ -d "$PENS_ROOT/$p/.git" ] && kind="git-superproject"
    pm="$pm\n  $p:\n    type: $kind\n    local: $PENS_ROOT/$p"
  done
  pm="$pm\n\nconvention:\n  - pens is a pointer repo (manifest + registry only).\n  - '*' ignores every pen; pens is never a monorepo.\n  - No submodules; each component repo has its own GitHub remote."
  printf "%b\n" "$pm" > "$PENS_ROOT/pens.yaml"
  echo "generated $PENS_ROOT/pens.yaml"
}

# --- generate olympus-pantheon.md from the live local olympus registry (auto, reliable source) ---
generate_pantheon() {
  local reg="$PENS_ROOT/olympus/README.md"
  [ -f "$reg" ] || { echo "olympus registry missing: $reg" >&2; return 1; }
  local out="# Olympus pantheon — the Greek-coded products (AUTO-GENERATED by pensctl; do not edit).\n# Source: local $reg\n\n| Codename | Greek root | Meaning | Product | Lives in |\n| --- | --- | --- | --- | --- |\n"
  # pull the pantheon rows from the live olympus README (the reliable table)
  local rows=""
  while IFS= read -r line; do
    rows="$rows$line\n"
  done < <(grep -F "| **" "$reg")
  printf "%b\n" "$out$rows" > "$PENS_ROOT/olympus-pantheon.md"
  echo "generated $PENS_ROOT/olympus-pantheon.md (from live olympus registry)"
}

list_pens() {
  echo "pens in $PENS_ROOT:"
  for p in $(pens); do
    local kind; [ -d "$PENS_ROOT/$p/.git" ] && kind="git-superproject" || kind="local-dir"
    printf "  %-14s %s\n" "$p" "$kind"
  done
}

case "${1:-list}" in
  list) list_pens ;;
  add) local p="$2"; [ -z "${p:-}" ] && { echo "usage: pensctl add <pen>" >&2; exit 2; }; mkdir -p "$PENS_ROOT/$p"; generate_ignore; echo "added pen '$p'"; ;;
  generate-ignore) generate_ignore ;;
  generate-yaml) generate_yaml ;;
  generate-pantheon) generate_pantheon ;;
  generate-all) generate_ignore; generate_yaml; generate_pantheon ;;
  doctor)
    [ -d "$PENS_ROOT/.git" ] && echo "pens root IS a git repo (pointer superproject, expected)."
    echo "tracked files ($(cd "$PENS_ROOT" && git ls-files 2>/dev/null | wc -l)):"; (cd "$PENS_ROOT" && git ls-files 2>/dev/null) | sed 's/^/  /'
    list_pens ;;
  *) echo "usage: pensctl (list|add <pen>|generate-ignore|generate-yaml|generate-pantheon|generate-all|doctor)"; exit 2;;
esac