#!/usr/bin/env bash
# pensctl — manage the fully-local pens/ organization.
# The pens root is NOT a git repo; it ignores every pen so it never becomes a
# monorepo. Each pen is independent (own git checkout or pure local dir).
#
#   pensctl list              list pens + their git/no-git status
#   pensctl add <pen>         create a new pen (dir) + regenerate the ignore
#   pensctl generate-ignore   regenerate .gitignore from the declared pen set
#   pensctl doctor            report any pen that leaked into ghost/gitchain
set -u
PENS_ROOT="${PENS_ROOT:-/home/toxic/pens}"

pens() { (cd "$PENS_ROOT" && ls -d */ 2>/dev/null | sed 's#/$##'); }

generate_ignore() {
  local ignore="$PENS_ROOT/.gitignore"
  {
    echo "# pens/.gitignore — AUTO-GENERATED by pensctl (do not edit by hand)."
    echo "# pens is a fully-local container; every pen is ignored so pens never becomes a monorepo."
    echo "# Regenerate with: pensctl generate-ignore"
    echo "*"
    echo "!.gitignore"
    echo "!pensctl"
    echo "!pens.yaml"
  } > "$ignore"
  echo "regenerated $ignore"
}

list_pens() {
  echo "pens in $PENS_ROOT:"
  for p in $(pens); do
    local kind
    if [ -d "$PENS_ROOT/$p/.git" ]; then kind="git-checkout"; else kind="local-dir"; fi
    printf "  %-14s %s\n" "$p" "$kind"
  done
}

case "${1:-list}" in
  list) list_pens ;;
  add)
    p="$2"
    [ -z "${p:-}" ] && { echo "usage: pensctl add <pen>" >&2; exit 2; }
    [ -d "$PENS_ROOT/$p" ] && { echo "pen '$p' exists" >&2; exit 1; }
    mkdir -p "$PENS_ROOT/$p"
    generate_ignore
    echo "added pen '$p' → $PENS_ROOT/$p"
    ;;
  generate-ignore) generate_ignore ;;
  doctor)
    # complain if any top-level pens dir is tracked by a .git at pens root (shouldn't exist)
    [ -d "$PENS_ROOT/.git" ] && { echo "⚠ pens root has a .git — pens should be a plain container" >&2; exit 1; }
    echo "pens root clean (no .git, ignores every pen)."; list_pens ;;
  *) echo "usage: pensctl (list|add <pen>|generate-ignore|doctor)" >&2; exit 2;;
esac